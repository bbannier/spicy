# @TEST-REQUIRES: which FileCheck
# @TEST-EXEC: hiltic %INPUT -p -D optimizer >>output 2>&1
# @TEST-EXEC: FileCheck %INPUT < output

module foo {

import hilti;

# CHECK: expression::Name "my_stop" -> expression::Ctor "False" (inlining expression)

# CHECK: function bool fn
function bool fn() {
    local bool my_stop = False;
    local uint<8> x = 0;
    x = x + 1;

    # CHECK-NOT: my_stop || True;
    {
        local uint<8> x = 0;
        x = x + 1;

        local uint<8> y = x + 1;

        {
            local uint<8> y = x + 1;
            hilti::print(y, True);
        }

        my_stop = my_stop || cast<bool>(x) || cast<bool>(y);
    }

    return my_stop || cast<bool>(x);
}

fn();

}

